# Скопируйте в .env и заполните. .env не коммитится.

BOT_TOKEN=
# Какой бизнес запускать: папка в niches/ (barbershop, beauty, tutor или свой)
NICHE=barbershop
# PostgreSQL. Через docker compose: postgresql://booking:ПАРОЛЬ@127.0.0.1:5434/booking
# (127.0.0.1, а не localhost: на Windows localhost сначала пробует IPv6 и теряет ~2 с на соединение)
DATABASE_URL=
POSTGRES_PASSWORD=
REDIS_URL=
# Telegram ID админов через запятую. Мастерам — tg_id в catalog.yaml
ADMIN_IDS=

# Публичный HTTPS-адрес мини-приложения
WEBAPP_URL=
# Вебхук вместо polling: тот же адрес + секрет (openssl rand -hex 32)
WEBHOOK_URL=
WEBHOOK_SECRET=
# false — не подключаться к Telegram (локальная разработка при живом боте на сервере)
POLLING=true

# Провайдер карт из @BotFather → Payments (ЮKassa) — для предоплаты (prepay в config.yaml)
PAYMENT_TOKEN=
# JSON-ключ сервисного аккаунта Google для синхронизации календарей мастеров; пусто — выключено
GOOGLE_CREDENTIALS_FILE=

HOST=127.0.0.1
PORT=8085
